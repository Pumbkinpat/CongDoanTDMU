{
    "name": "tdmu/congdoan-cms",
    "type": "project",
    "description": "Website Truyền Thông Công Đoàn TDMU Tích Hợp AI Sáng Tạo Nội Dung - Laravel 10 & SQL Server 2020",
    "keywords": ["laravel", "framework", "ai", "gemini", "tdmu", "congdoan"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
