{
    "name": "tdmu/congdoan-cms",
    "type": "project",
    "description": "Website Truyền Thông Công Đoàn TDMU Tích Hợp AI Sáng Tạo Nội Dung - Laravel 11 & MySQL",
    "keywords": ["laravel", "framework", "ai", "gemini", "tdmu", "congdoan"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy.advisories.block": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}